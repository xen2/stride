    ParticleBase.BaseColor: !ShaderMixinSource
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.ComputeColorMultiply
        Compositions:
            color1: !ShaderClassSource
                ClassName: Stride.Rendering.ComputeColorConstantColorLink
                GenericArguments: [ParticleBase.EmissiveValue]
            color2: !ShaderMixinSource
                Mixins:
                    - !ShaderClassSource
                        ClassName: Stride.Rendering.ComputeColorMultiply
                Compositions:
                    color1: !ShaderClassSource
                        ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler
                        GenericArguments: [ParticleBase.EmissiveMap, TEXCOORD0, Material.Sampler.i0, rgba, Material.TextureScale, Material.TextureOffset]
                    color2: !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorMultiply
                        Compositions:
                            color1: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler
                                GenericArguments: [ParticleBase.EmissiveMap.i1, TEXCOORD0, Material.Sampler.i0, rgba, Material.TextureScale.i1, Material.TextureOffset.i1]
                            color2: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorFromStream
                                GenericArguments: [COLOR0, rgba]
    StrideEffectBase.RenderTargetExtensions: !ShaderMixinSource
        Macros:
            -   Name: STRIDE_MULTISAMPLE_COUNT
                Definition: 1

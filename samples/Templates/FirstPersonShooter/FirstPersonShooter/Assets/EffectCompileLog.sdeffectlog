---
!EffectCompileRequest
EffectName: Stride.Rendering.StrideForwardShadingEffect.ShadowMapCaster
UsedParameters:
    Material.PixelStageSurfaceShaders: !ShaderMixinSource
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialSurfaceArray
        Compositions:
            layers: !ShaderArraySource
                Values:
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceDiffuse
                        Compositions:
                            diffuseMap: !ShaderMixinSource
                                Mixins:
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.ComputeColorAdd3ds
                                Compositions:
                                    color1: !ShaderClassSource
                                        ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler
                                        GenericArguments: [Material.DiffuseMap, TEXCOORD0, Material.Sampler.i0, rgba, Material.TextureScale, Material.TextureOffset]
                                    color2: !ShaderClassSource
                                        ClassName: Stride.Rendering.ComputeColorConstantColorLink
                                        GenericArguments: [Material.DiffuseValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceGlossinessMap
                                GenericArguments: [false]
                        Compositions:
                            glossinessMap: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments: [Material.GlossinessValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceMetalness
                        Compositions:
                            metalnessMap: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments: [Material.MetalnessValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceLightingAndShading
                        Compositions:
                            surfaces: !ShaderArraySource
                                Values:
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceShadingDiffuseLambert
                                        GenericArguments: [false]
                                    - !ShaderMixinSource
                                        Mixins:
                                            - !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSurfaceShadingSpecularMicrofacet
                                        Compositions:
                                            environmentFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetEnvironmentGGXLUT
                                            fresnelFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetFresnelSchlick
                                            geometricShadowingFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetVisibilitySmithSchlickGGX
                                            normalDistributionFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetNormalDistributionGGX
    Material.PixelStageStreamInitializer: !ShaderMixinSource
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialStream
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialPixelShadingStream
---
!EffectCompileRequest
EffectName: Stride.Rendering.StrideForwardShadingEffect.ShadowMapCaster
UsedParameters:
    Material.PixelStageSurfaceShaders: !ShaderMixinSource
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialSurfaceArray
        Compositions:
            layers: !ShaderArraySource
                Values:
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceDiffuse
                        Compositions:
                            diffuseMap: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantColorLink
                                GenericArguments: [Material.DiffuseValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceNormalMap
                                GenericArguments: [true, true]
                        Compositions:
                            normalMap: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler
                                GenericArguments: [Material.NormalMap, TEXCOORD0, Material.Sampler.i0, rgba, Material.TextureScale, Material.TextureOffset]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceGlossinessMap
                                GenericArguments: [false]
                        Compositions:
                            glossinessMap: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments: [Material.GlossinessValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                GenericArguments: [matSpecular, rgb]
                        Compositions:
                            computeColorSource: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantColorLink
                                GenericArguments: [Material.SpecularValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                GenericArguments: [matSpecularIntensity, r]
                        Compositions:
                            computeColorSource: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments: [Material.SpecularIntensityValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                GenericArguments: [matAmbientOcclusion, r]
                        Compositions:
                            computeColorSource: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler
                                GenericArguments: [Material.AmbientOcclusionMap, TEXCOORD0, Material.Sampler.i0, r, Material.TextureScale.i1, Material.TextureOffset.i1]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                GenericArguments: [matAmbientOcclusionDirectLightingFactor, r]
                        Compositions:
                            computeColorSource: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments: [Material.AmbientOcclusionDirectLightingFactorValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                GenericArguments: [matCavity, r]
                        Compositions:
                            computeColorSource: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments: [Material.CavityValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                GenericArguments: [matCavityDiffuse, r]
                        Compositions:
                            computeColorSource: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments: [Material.CavityDiffuseValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                GenericArguments: [matCavitySpecular, r]
                        Compositions:
                            computeColorSource: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments: [Material.CavitySpecularValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceStreamsBlend
                        Compositions:
                            blends: !ShaderArraySource
                                Values:
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialStreamLinearBlend
                                        GenericArguments: [matDiffuse]
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialStreamLinearBlend
                                        GenericArguments: [matColorBase]
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialStreamNormalBlend
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialStreamLinearBlend
                                        GenericArguments: [matGlossiness]
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialStreamLinearBlend
                                        GenericArguments: [matSpecular]
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialStreamLinearBlend
                                        GenericArguments: [matSpecularIntensity]
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialStreamLinearBlend
                                        GenericArguments: [matAmbientOcclusion]
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialStreamLinearBlend
                                        GenericArguments: [matAmbientOcclusionDirectLightingFactor]
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialStreamLinearBlend
                                        GenericArguments: [matCavity]
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialStreamLinearBlend
                                        GenericArguments: [matCavityDiffuse]
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialStreamLinearBlend
                                        GenericArguments: [matCavitySpecular]
                            layer: !ShaderMixinSource
                                Mixins:
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceArray
                                Compositions:
                                    layers: !ShaderArraySource
                                        Values:
                                            - !ShaderMixinSource
                                                Mixins:
                                                    - !ShaderClassSource
                                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceDiffuse
                                                Compositions:
                                                    diffuseMap: !ShaderClassSource
                                                        ClassName: Stride.Rendering.ComputeColorConstantColorLink
                                                        GenericArguments: [Material.DiffuseValue.i1]
                                            - !ShaderMixinSource
                                                Mixins:
                                                    - !ShaderClassSource
                                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceNormalMap
                                                        GenericArguments: [true, true]
                                                Compositions:
                                                    normalMap: !ShaderClassSource
                                                        ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler
                                                        GenericArguments: [Material.NormalMap.i1, TEXCOORD0, Material.Sampler.i0, rgba, Material.TextureScale.i2, Material.TextureOffset.i2]
                                            - !ShaderMixinSource
                                                Mixins:
                                                    - !ShaderClassSource
                                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceGlossinessMap
                                                        GenericArguments: [false]
                                                Compositions:
                                                    glossinessMap: !ShaderClassSource
                                                        ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                                        GenericArguments: [Material.GlossinessValue.i1]
                                            - !ShaderMixinSource
                                                Mixins:
                                                    - !ShaderClassSource
                                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                                        GenericArguments: [matSpecular, rgb]
                                                Compositions:
                                                    computeColorSource: !ShaderClassSource
                                                        ClassName: Stride.Rendering.ComputeColorConstantColorLink
                                                        GenericArguments: [Material.SpecularValue.i1]
                                            - !ShaderMixinSource
                                                Mixins:
                                                    - !ShaderClassSource
                                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                                        GenericArguments: [matSpecularIntensity, r]
                                                Compositions:
                                                    computeColorSource: !ShaderClassSource
                                                        ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                                        GenericArguments: [Material.SpecularIntensityValue.i1]
                                            - !ShaderMixinSource
                                                Mixins:
                                                    - !ShaderClassSource
                                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                                        GenericArguments: [matAmbientOcclusion, r]
                                                Compositions:
                                                    computeColorSource: !ShaderClassSource
                                                        ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler
                                                        GenericArguments: [Material.AmbientOcclusionMap.i1, TEXCOORD0, Material.Sampler.i0, r, Material.TextureScale.i3, Material.TextureOffset.i3]
                                            - !ShaderMixinSource
                                                Mixins:
                                                    - !ShaderClassSource
                                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                                        GenericArguments: [matAmbientOcclusionDirectLightingFactor, r]
                                                Compositions:
                                                    computeColorSource: !ShaderClassSource
                                                        ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                                        GenericArguments: [Material.AmbientOcclusionDirectLightingFactorValue.i1]
                                            - !ShaderMixinSource
                                                Mixins:
                                                    - !ShaderClassSource
                                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                                        GenericArguments: [matCavity, r]
                                                Compositions:
                                                    computeColorSource: !ShaderClassSource
                                                        ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                                        GenericArguments: [Material.CavityValue.i1]
                                            - !ShaderMixinSource
                                                Mixins:
                                                    - !ShaderClassSource
                                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                                        GenericArguments: [matCavityDiffuse, r]
                                                Compositions:
                                                    computeColorSource: !ShaderClassSource
                                                        ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                                        GenericArguments: [Material.CavityDiffuseValue.i1]
                                            - !ShaderMixinSource
                                                Mixins:
                                                    - !ShaderClassSource
                                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                                        GenericArguments: [matCavitySpecular, r]
                                                Compositions:
                                                    computeColorSource: !ShaderClassSource
                                                        ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                                        GenericArguments: [Material.CavitySpecularValue.i1]
                                            - !ShaderMixinSource
                                                Mixins:
                                                    - !ShaderClassSource
                                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                                        GenericArguments: [matBlend, r]
                                                Compositions:
                                                    computeColorSource: !ShaderClassSource
                                                        ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler
                                                        GenericArguments: [Material.BlendMap, TEXCOORD0, Material.Sampler.i0, a, Material.TextureScale.i4, Material.TextureOffset.i4]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceLightingAndShading
                        Compositions:
                            surfaces: !ShaderArraySource
                                Values:
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceShadingDiffuseLambert
                                        GenericArguments: [false]
                                    - !ShaderMixinSource
                                        Mixins:
                                            - !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSurfaceShadingSpecularMicrofacet
                                        Compositions:
                                            environmentFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetEnvironmentGGXLUT
                                            fresnelFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetFresnelSchlick
                                            geometricShadowingFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetVisibilitySmithSchlickGGX
                                            normalDistributionFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetNormalDistributionGGX
    Material.PixelStageStreamInitializer: !ShaderMixinSource
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialStream
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialPixelShadingStream
    Material.HasNormalMap: true
---
!EffectCompileRequest
EffectName: Stride.Rendering.StrideForwardShadingEffect
UsedParameters:
    Material.PixelStageSurfaceShaders: !ShaderMixinSource
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialSurfaceArray
        Compositions:
            layers: !ShaderArraySource
                Values:
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceDiffuse
                        Compositions:
                            diffuseMap: !ShaderMixinSource
                                Mixins:
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.ComputeColorAdd3ds
                                Compositions:
                                    color1: !ShaderClassSource
                                        ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler
                                        GenericArguments: [Material.DiffuseMap, TEXCOORD0, Material.Sampler.i0, rgba, Material.TextureScale, Material.TextureOffset]
                                    color2: !ShaderClassSource
                                        ClassName: Stride.Rendering.ComputeColorConstantColorLink
                                        GenericArguments: [Material.DiffuseValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceGlossinessMap
                                GenericArguments: [false]
                        Compositions:
                            glossinessMap: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments: [Material.GlossinessValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceMetalness
                        Compositions:
                            metalnessMap: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments: [Material.MetalnessValue]
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceLightingAndShading
                        Compositions:
                            surfaces: !ShaderArraySource
                                Values:
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceShadingDiffuseLambert
                                        GenericArguments: [false]
                                    - !ShaderMixinSource
                                        Mixins:
                                            - !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSurfaceShadingSpecularMicrofacet
                                        Compositions:
                                            environmentFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetEnvironmentGGXLUT
                                            fresnelFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetFresnelSchlick
                                            geometricShadowingFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetVisibilitySmithSchlickGGX
                                            normalDistributionFunction: !ShaderClassSource
                                                ClassName: Stride.Rendering.Materials.MaterialSpecularMicrofacetNormalDistributionGGX
    Material.PixelStageStreamInitializer: !ShaderMixinSource
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialStream
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialPixelShadingStream
    Lighting.DirectLightGroups:
        - !ShaderMixinSource
            Mixins:
                - !ShaderClassSource
                    ClassName: Stride.Rendering.Lights.LightDirectionalGroup
                    GenericArguments: [1]
                - !ShaderClassSource
                    ClassName: Stride.Rendering.Shadows.ShadowMapReceiverDirectional
                    GenericArguments: [4, 1, true, true, false, false]
                - !ShaderClassSource
                    ClassName: Stride.Rendering.Shadows.ShadowMapFilterPcf
                    GenericArguments: [PerView.Lighting, 5]
        - !ShaderClassSource
            ClassName: Stride.Rendering.Lights.LightClusteredPointGroup
        - !ShaderClassSource
            ClassName: Stride.Rendering.Lights.LightClusteredSpotGroup
    Lighting.EnvironmentLights:
        - !ShaderClassSource
            ClassName: Stride.Rendering.Lights.LightSimpleAmbient
        - !ShaderMixinGeneratorSource
            Name: Stride.Rendering.Lights.LightSkyboxEffect
        - !ShaderClassSource
            ClassName: Stride.Rendering.Lights.EnvironmentLight
    LightSkyboxShader.LightDiffuseColor.environmentLights[1]: !ShaderClassSource
        ClassName: Stride.Rendering.Skyboxes.SphericalHarmonicsEnvironmentColor
        GenericArguments: [3]
    LightSkyboxShader.LightSpecularColor.environmentLights[1]: !ShaderClassSource
        ClassName: Stride.Rendering.Skyboxes.RoughnessCubeMapEnvironmentColor
    StrideEffectBase.RenderTargetExtensions: !ShaderMixinSource
        Macros:
            -   Name: STRIDE_RENDER_TARGET_COUNT
                Definition: 1
            -   Name: STRIDE_MULTISAMPLE_COUNT
                Definition: 1
---
!EffectCompileRequest
EffectName: Stride.Rendering.StrideForwardShadingEffect
UsedParameters:
    Material.PixelStageSurfaceShaders: !ShaderMixinSource
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialSurfaceArray
        Compositions:
            layers: !ShaderArraySource
                Values:
                    - !ShaderMixinSource
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceDiffuse
                        Compositions:
                            diffuseMap: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler

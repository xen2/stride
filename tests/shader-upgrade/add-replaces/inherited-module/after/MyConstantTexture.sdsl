shader MyConstantTexture
{
    import MyConstantColor;
    import Texturing;

    [Replaces(MyConstantColor)]
    override module void VSMain()
    {
        streams.ShadingPosition = mul(streams.Position, WorldViewProjection);
    }

    [Replaces(MyConstantColor)]
    override module void PSMain()
    {
        // base.PSMain();
        streams.ColorTarget = Texture0.Sample(LinearSampler, streams.TexCoord) * Color;
    }
};

using ShaderPipe;

namespace ShaderStepA
{
    /// <summary>A step of the point of another package. It doesn't know the other step.</summary>
    module StepA
    {
        import PipeOwner;

        [Phase(Scene)]
        override void ModifyValue()
        {
            base.ModifyValue();
            streams.PipeValue = lerp(streams.PipeValue, 0.1, 0.5);
        }
    };
}

namespace ShaderPipe
{
    /// <summary>Runs the point from a fixed value.</summary>
    module PipeRoot
    {
        import SpriteBase;
        import PipeOwner;

        [Phase(Surface)]
        override float4 Shading()
        {
            streams.PipeValue = 0.5;
            ModifyValue();
            return float4(streams.PipeValue, 0.0, 0.0, 1.0);
        }
    };
}

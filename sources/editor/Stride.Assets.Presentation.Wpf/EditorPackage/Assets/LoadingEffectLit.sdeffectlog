        Compositions: {}
        Macros: []
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialStream
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialPixelShadingStream
        Name: null
    Material.PixelStageSurfaceFilter: null
    Material.PixelStageSurfaceShaders: !ShaderMixinSource
        Compositions:
            layers: !ShaderArraySource
                Values:
                    - !ShaderMixinSource
                        Compositions:
                            diffuseMap: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler
                                GenericArguments:
                                    - Material.DiffuseMap
                                    - TEXCOORD0
                                    - Material.Sampler.i0
                                    - rgba
                                    - Material.TextureScale
                                    - Material.TextureOffset
                        Macros: []
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceDiffuse
                        Name: null
                    - !ShaderMixinSource
                        Compositions:
                            surfaces: !ShaderArraySource
                                Values:
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.Materials.MaterialSurfaceShadingDiffuseLambert
                                        GenericArguments:
                                            - false
                        Macros: []
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceLightingAndShading
                        Name: null
        Macros: []
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialSurfaceArray
        Name: null
    Material.TessellationShader: null
    Material.VertexStageSurfaceShaders: null
    StrideEffectBase.ExtensionPostVertexStageShader: null
    SceneEditorParameters.IsEffectCompiling: true
    SceneEditorParameters.IsEffectError: false

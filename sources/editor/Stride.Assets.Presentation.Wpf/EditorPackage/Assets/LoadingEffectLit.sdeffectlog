---
!EffectCompileRequest
EffectName: Stride.Rendering.StrideEditorForwardShadingEffect
UsedParameters:
    Lighting.DirectLightGroups: null
    Lighting.EnvironmentLights:
        - !ShaderClassSource
            ClassName: Stride.Rendering.Lights.LightConstantWhite
    Material.HasNormalMap: false
    Material.HasSkinningPosition: false

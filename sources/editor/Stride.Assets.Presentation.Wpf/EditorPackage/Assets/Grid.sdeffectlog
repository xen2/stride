---
!EffectCompileRequest
EffectName: Stride.Rendering.StrideEditorForwardShadingEffect
UsedParameters:
    Material.PixelStageSurfaceShaders: !ShaderMixinSource
        Compositions:
            layers: !ShaderArraySource
                Values:
                    - !ShaderMixinSource
                        Compositions:
                            computeColorSource: !ShaderMixinSource
                                Compositions:
                                    color1: !ShaderClassSource
                                        ClassName: Stride.Rendering.ComputeColorConstantColorLink
                                        GenericArguments:
                                            - ViewportGridGizmo.GridColorKey
                                    color2: !ShaderClassSource
                                        ClassName: Stride.Rendering.ComputeColorTextureScaledOffsetDynamicSampler
                                        GenericArguments:
                                            - Stride.Rendering.Texturing.Texture0
                                            - TEXCOORD0
                                            - Material.Sampler.i0
                                            - rgba
                                            - Material.TextureScale
                                            - Material.TextureOffset
                                Macros: []
                                Mixins:
                                    - !ShaderClassSource
                                        ClassName: Stride.Rendering.ComputeColorMultiply
                        Macros: []
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                GenericArguments:
                                    - matEmissive
                                    - rgba
                    - !ShaderMixinSource
                        Compositions:
                            computeColorSource: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments:
                                    - Material.EmissiveIntensity
                        Macros: []
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                GenericArguments:
                                    - matEmissiveIntensity
                                    - r
                    - !ShaderMixinSource
                        Compositions:
                            computeColorSource: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantFloatLink
                                GenericArguments:
                                    - Material.DiffuseSpecularAlphaBlendValue
                        Macros: []
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                GenericArguments:
                                    - matDiffuseSpecularAlphaBlend
                                    - r
                    - !ShaderMixinSource
                        Compositions:
                            computeColorSource: !ShaderClassSource
                                ClassName: Stride.Rendering.ComputeColorConstantColorLink
                                GenericArguments:
                                    - Material.AlphaBlendColorValue
                        Macros: []
                        Mixins:
                            - !ShaderClassSource
                                ClassName: Stride.Rendering.Materials.MaterialSurfaceSetStreamFromComputeColor
                                GenericArguments:
                                    - matAlphaBlendColor
                                    - rgb
                    - !ShaderClassSource
                        ClassName: Stride.Rendering.Materials.MaterialSurfaceEmissiveShading
                        GenericArguments:
                            - true
                    - !ShaderClassSource
                        ClassName: Stride.Rendering.Materials.MaterialSurfaceDiffuseSpecularAlphaBlendColor
        Macros: []
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialSurfaceArray
    Material.PixelStageStreamInitializer: !ShaderMixinSource
        Compositions: {}
        Macros: []
        Mixins:
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialStream
            - !ShaderClassSource
                ClassName: Stride.Rendering.Materials.MaterialPixelShadingStream
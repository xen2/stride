namespace Stride.Rendering;

module SpriteEffect
{
    import SpriteBase;

    // Color used to tint the sprite
    [Color]
    float4 Color = float4(1,1,1,1);

    // Shading of the sprite
    [Phase(Post)]
    extend SpriteBase.Shading()
    {
        return next() * Color;
    }
};

module SpriteEffect
{
    import SpriteBase;

    // Color used to tint the sprite
    [Color]
    float4 Color = float4(1,1,1,1);

    // Shading of the sprite
    override float4 Shading()
    {
        return base.Shading() * Color;
    }
};

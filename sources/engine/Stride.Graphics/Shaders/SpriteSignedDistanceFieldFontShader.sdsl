namespace Stride.Rendering;

shader SpriteSignedDistanceFieldFontShader
{
    import SpriteBase;
    import SignedDistanceFieldFont;

    module stream float4 Color : COLOR;

    // Shading of the sprite
    extend SpriteBase.Shading in Post
    {
        return FontColor(next(), streams.Color, float4(0,0,0,1), 0.f);
    }
};

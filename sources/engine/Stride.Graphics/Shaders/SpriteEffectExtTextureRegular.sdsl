shader SpriteEffectExtTextureRegular
{
    import ShaderBase;

    module Texture2D TextureRegular;

    module SamplerState Sampler;
    module float MipLevel;

    module stream float2 TexCoord : TEXCOORD0;
    module stream float4 Position : POSITION;

    module override void VSMain()
    {
        streams.ShadingPosition = streams.Position;
    }

    module override void PSMain()
    {
        streams.ColorTarget = Shading();
    }

    module float4 Shading()
    {
        return TextureRegular.SampleLevel(Sampler, streams.TexCoord, MipLevel);
    }
};

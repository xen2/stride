// Base shader for all the graphics shaders

namespace Stride.Rendering;

[Root]
module ShaderBase
{
    import ShaderBaseStream;

    // Declare Vertex shader main method
    [Phases(Input, Default, Deform, Transform, Attributes, Screen)]
    pipeline void VSMain() {}

    // Declare Pixel shader main method
    [Phases(Input, Default, Shade, Output)]
    pipeline void PSMain() {}
};

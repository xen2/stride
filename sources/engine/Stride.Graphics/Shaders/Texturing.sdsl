module Texturing
{
    // Default texture slots - might be automatically used by the material
    Texture2D Texture0;
    float2 Texture0TexelSize;
    Texture2D Texture1;
    float2 Texture1TexelSize;
    Texture2D Texture2;
    float2 Texture2TexelSize;
    Texture2D Texture3;
    float2 Texture3TexelSize;
    Texture2D Texture4;
    float2 Texture4TexelSize;
    Texture2D Texture5;
    float2 Texture5TexelSize;
    Texture2D Texture6;
    float2 Texture6TexelSize;
    Texture2D Texture7;
    float2 Texture7TexelSize;
    Texture2D Texture8;
    float2 Texture8TexelSize;
    Texture2D Texture9;
    float2 Texture9TexelSize;

    // Default texture cube slots
    TextureCube TextureCube0;
    TextureCube TextureCube1;
    TextureCube TextureCube2;
    TextureCube TextureCube3;

    // Default texture 3D slots
    Texture3D Texture3D0;
    Texture3D Texture3D1;
    Texture3D Texture3D2;
    Texture3D Texture3D3;

    // Default sampler
    SamplerState Sampler;

    SamplerState PointSampler
    {
        Filter = MIN_MAG_MIP_POINT;
    };

    SamplerState LinearSampler
    {
        Filter = MIN_MAG_MIP_LINEAR;
    };

    SamplerState LinearBorderSampler
    {
        Filter = MIN_MAG_MIP_LINEAR;
        AddressU = Border;
        AddressV = Border;
    };

    SamplerComparisonState LinearClampCompareLessEqualSampler
    {
        Filter = COMPARISON_MIN_MAG_LINEAR_MIP_POINT;
        AddressU = Clamp;
        AddressV = Clamp;
        ComparisonFunc = LessEqual;

    };

    SamplerState AnisotropicSampler
    {
        Filter = ANISOTROPIC;
    };

    SamplerState AnisotropicRepeatSampler
    {
        Filter = ANISOTROPIC;
        AddressU = Wrap;
        AddressV = Wrap;
        MaxAnisotropy = 16;
    };

    SamplerState PointRepeatSampler
    {
        Filter = MIN_MAG_MIP_POINT;
        AddressU = Wrap;
        AddressV = Wrap;
    };

    SamplerState LinearRepeatSampler
    {
        Filter = MIN_MAG_MIP_LINEAR;
        AddressU = Wrap;
        AddressV = Wrap;
    };

    SamplerState RepeatSampler
    {
        AddressU = Wrap;
        AddressV = Wrap;
    };

    // Default custom samplers - might be automatically used by the materials
    SamplerState Sampler0;
    SamplerState Sampler1;
    SamplerState Sampler2;
    SamplerState Sampler3;
    SamplerState Sampler4;
    SamplerState Sampler5;
    SamplerState Sampler6;
    SamplerState Sampler7;
    SamplerState Sampler8;
    SamplerState Sampler9;

    // Texcoord attribute inputs
    stream float2 TexCoord : TEXCOORD0;
    stream float2 TexCoord1 : TEXCOORD1;
    stream float2 TexCoord2 : TEXCOORD2;
    stream float2 TexCoord3 : TEXCOORD3;
    stream float2 TexCoord4 : TEXCOORD4;
    stream float2 TexCoord5 : TEXCOORD5;
    stream float2 TexCoord6 : TEXCOORD6;
    stream float2 TexCoord7 : TEXCOORD7;
    stream float2 TexCoord8 : TEXCOORD8;
    stream float2 TexCoord9 : TEXCOORD9;
};

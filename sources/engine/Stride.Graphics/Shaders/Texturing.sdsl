shader Texturing
{
    // Default texture slots - might be automatically used by the material
    module Texture2D Texture0;
    module float2 Texture0TexelSize;
    module Texture2D Texture1;
    module float2 Texture1TexelSize;
    module Texture2D Texture2;
    module float2 Texture2TexelSize;
    module Texture2D Texture3;
    module float2 Texture3TexelSize;
    module Texture2D Texture4;
    module float2 Texture4TexelSize;
    module Texture2D Texture5;
    module float2 Texture5TexelSize;
    module Texture2D Texture6;
    module float2 Texture6TexelSize;
    module Texture2D Texture7;
    module float2 Texture7TexelSize;
    module Texture2D Texture8;
    module float2 Texture8TexelSize;
    module Texture2D Texture9;
    module float2 Texture9TexelSize;

    // Default texture cube slots
    module TextureCube TextureCube0;
    module TextureCube TextureCube1;
    module TextureCube TextureCube2;
    module TextureCube TextureCube3;

    // Default texture 3D slots
    module Texture3D Texture3D0;
    module Texture3D Texture3D1;
    module Texture3D Texture3D2;
    module Texture3D Texture3D3;

    // Default sampler
    module SamplerState Sampler;

    module SamplerState PointSampler
    {
        Filter = MIN_MAG_MIP_POINT;
    };

    module SamplerState LinearSampler
    {
        Filter = MIN_MAG_MIP_LINEAR;
    };

    module SamplerState LinearBorderSampler
    {
        Filter = MIN_MAG_MIP_LINEAR;
        AddressU = Border;
        AddressV = Border;
    };

    module SamplerComparisonState LinearClampCompareLessEqualSampler
    {
        Filter = COMPARISON_MIN_MAG_LINEAR_MIP_POINT;
        AddressU = Clamp;
        AddressV = Clamp;
        ComparisonFunc = LessEqual;

    };

    module SamplerState AnisotropicSampler
    {
        Filter = ANISOTROPIC;
    };

    module SamplerState AnisotropicRepeatSampler
    {
        Filter = ANISOTROPIC;
        AddressU = Wrap;
        AddressV = Wrap;
        MaxAnisotropy = 16;
    };

    module SamplerState PointRepeatSampler
    {
        Filter = MIN_MAG_MIP_POINT;
        AddressU = Wrap;
        AddressV = Wrap;
    };

    module SamplerState LinearRepeatSampler
    {
        Filter = MIN_MAG_MIP_LINEAR;
        AddressU = Wrap;
        AddressV = Wrap;
    };

    module SamplerState RepeatSampler
    {
        AddressU = Wrap;
        AddressV = Wrap;
    };

    // Default custom samplers - might be automatically used by the materials
    module SamplerState Sampler0;
    module SamplerState Sampler1;
    module SamplerState Sampler2;
    module SamplerState Sampler3;
    module SamplerState Sampler4;
    module SamplerState Sampler5;
    module SamplerState Sampler6;
    module SamplerState Sampler7;
    module SamplerState Sampler8;
    module SamplerState Sampler9;

    // Texcoord attribute inputs
    module stream float2 TexCoord : TEXCOORD0;
    module stream float2 TexCoord1 : TEXCOORD1;
    module stream float2 TexCoord2 : TEXCOORD2;
    module stream float2 TexCoord3 : TEXCOORD3;
    module stream float2 TexCoord4 : TEXCOORD4;
    module stream float2 TexCoord5 : TEXCOORD5;
    module stream float2 TexCoord6 : TEXCOORD6;
    module stream float2 TexCoord7 : TEXCOORD7;
    module stream float2 TexCoord8 : TEXCOORD8;
    module stream float2 TexCoord9 : TEXCOORD9;
};

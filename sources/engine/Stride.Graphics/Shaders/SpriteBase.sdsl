[Root]
module SpriteBase
{
    import ShaderBase;
    import Texturing;

    // -------------------------------------
    // streams
    // -------------------------------------
    stream float4 Position : POSITION;

    cbuffer PerDraw
    {
        // -------------------------------------
        // uniforms
        // -------------------------------------
        // A general transformation matrix
        float4x4 MatrixTransform;
    }
        
    // -------------------------------------
    // VertexShader
    // -------------------------------------
    override void VSMain()
    {
        streams.ShadingPosition = mul(streams.Position, MatrixTransform);
    }

    // Shading of the sprite
    override void PSMain()
    {
        streams.ColorTarget = Shading();
    }

    float4 Shading()
    {
        return Texture0.Sample(Sampler, streams.TexCoord);
    }
};

// Base stream for a shader
module ShaderBaseStream
{
    // Default SV_POSITION output for VS/GS shaders
    stream float4 ShadingPosition : SV_Position;

#if STRIDE_GRAPHICS_API_DIRECT3D && STRIDE_GRAPHICS_PROFILE < GRAPHICS_PROFILE_LEVEL_10_0
    // Positive if this face is a front face, negative otherwise
    stream float IsFrontFace : VFACE;
#else
    // True if this face is a front face
    stream bool IsFrontFace : SV_IsFrontFace;
#endif

    // Default COLOR outputs for PS shader
    stream float4 ColorTarget : SV_Target0;
    stream float4 ColorTarget1 : SV_Target1;
    stream float4 ColorTarget2 : SV_Target2;
    stream float4 ColorTarget3 : SV_Target3;
    stream float4 ColorTarget4 : SV_Target4;
    stream float4 ColorTarget5 : SV_Target5;
    stream float4 ColorTarget6 : SV_Target6;
    stream float4 ColorTarget7 : SV_Target7;

    // Default DEPTH output for PS shader
    stream float Depth : SV_Depth;
    stream float DepthGreater : SV_DepthGreater; // Special output after PS
    stream float DepthLessEqual : SV_DepthLessEqual; // Special output after PS

    // Default InstanceId for VS/GS shaders
    stream uint InstanceID : SV_InstanceID;
};

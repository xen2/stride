shader SimpleShader
{
    import ShaderBase;
    import Texturing;

    module stream float2 Position : POSITION;

    module float4 TestColor;

    module override void VSMain() 
    {
        streams.ShadingPosition = float4(streams.Position, 0.0f, 1.0f);
    }

    module override void PSMain() 
    {
        streams.ColorTarget = TestColor;
    }
};

namespace Stride.Graphics.Tests
{
    shader TextureArrayThirdElement
    {
        import ShaderBase;

        module stream float2 Position : POSITION;

        rgroup PerMaterial
        {
            [Link("TextureArrayTest.Textures")]
            module Texture2D Textures[4];
        }

        module override void VSMain()
        {
            streams.ShadingPosition = float4(streams.Position, 0.0f, 1.0f);
        }

        module override void PSMain()
        {
            streams.ColorTarget = Textures[2].Load(int3(0, 0, 0));
        }
    };
}

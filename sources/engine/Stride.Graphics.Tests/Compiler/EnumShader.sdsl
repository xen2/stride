namespace Stride.Graphics.Tests
{
    shader EnumShader
    {
        import SpriteBase;

        enum class Channel : uint { R, G, B = 5, A };
        struct Slot { float4 color; Channel channel; Channel fallback; uint pad0; uint pad1; };

        rgroup PerMaterial
        {
            [Link("EnumTest.Slots")]
            module StructuredBuffer<Slot> Slots;
        }

        cbuffer PerMaterial
        {
            [Link("EnumTest.Index")]
            module uint Index;
            [Link("EnumTest.Mode")]
            module Channel Mode;
        };

        // The channel of the slot (its fallback for A), or the one of the cbuffer when it isn't R
        module override float4 Shading()
        {
            var slot = Slots[Index];
            var channel = slot.channel == Channel.A ? slot.fallback : slot.channel;
            if (Mode != Channel.R)
                channel = Mode;
            switch (channel)
            {
                case Channel.R: return float4(slot.color.r, 0, 0, 1);
                case Channel.G: return float4(0, slot.color.g, 0, 1);
                case Channel.B: return float4(0, 0, slot.color.b, 1);
                case Channel.A: return float4(slot.color.aaa, 1);
            }
            return float4(1, 0, 1, 1);
        }
    };
}

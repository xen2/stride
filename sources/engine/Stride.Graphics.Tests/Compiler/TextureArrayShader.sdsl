namespace Stride.Graphics.Tests
{
    shader TextureArrayShader
    {
        import SpriteBase;

        rgroup PerMaterial
        {
            [Link("TextureArrayTest.Textures")]
            module Texture2D Textures[4];
        }

        cbuffer PerMaterial
        {
            [Link("TextureArrayTest.Index")]
            module uint Index;
        };

        // Direct3D 11 indexes a texture array with a constant only
        module override float4 Shading()
        {
#if STRIDE_GRAPHICS_API_DIRECT3D11
            return Textures[2].Load(int3(0, 0, 0));
#else
            return Textures[Index].Load(int3(0, 0, 0));
#endif
        }
    };
}

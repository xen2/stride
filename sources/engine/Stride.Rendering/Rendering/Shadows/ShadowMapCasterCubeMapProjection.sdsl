namespace Stride.Rendering.Shadows
{
    shader ShadowMapCasterCubeMapProjection
    {
        import TransformationBase;
        import PositionStream4;
        import Texturing;

        [Phase(Project)]
        [Drops(Phases = { Project })]
        module override void PostTransformPosition()
        {
            streams.ShadingPosition = ComputeShadingPosition(streams.PositionWS);
        }

		[Drops(Mixins = { TransformationWAndVP })]
		extend TransformationBase.ComputeShadingPosition(float4 world)
		{
			return mul(world, Transformation.ViewProjection);
		}
    };
}

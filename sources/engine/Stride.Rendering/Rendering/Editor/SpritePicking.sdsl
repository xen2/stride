namespace Stride.Rendering;

shader SpritePicking
{
    import SpriteBase;

    // -------------------------------------
    // streams
    // -------------------------------------
    module stream float4 Color : COLOR;

    // method computing color
    [Phase(Post)]
    extend SpriteBase.Shading()
    {
        next(); // discard pixel if needed.

        return streams.Color;
    }
};

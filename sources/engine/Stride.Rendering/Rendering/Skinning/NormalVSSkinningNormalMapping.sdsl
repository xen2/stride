namespace Stride.Rendering;

/// <summary>
/// Computes the transformation matrix from tangent to view space when skinning occured.
/// </summary>
module NormalVSSkinningNormalMapping
{
    import NormalFromNormalMapping;

    [Drops(Mixins = { NormalFromNormalMapping, NormalFromNormalMappingInstanced })]
    extend NormalUpdate.GetTangentWorldTransform()
    {
        // TangentMatrix is already in world space, so return an identity matrix here
        return float3x3(1,0,0, 0,1,0, 0,0,1);
    }
};

namespace Stride.Rendering.Images
{
    /// <summary>
    /// A copier shader
    /// </summary>
    internal shader ImageScalerShader
    {
        import ImageEffectShader;

        // TODO: Color and IsOnlyChannelRed could be part of a color filter that we can pre-prend automatically
        [Color]
        module float4 Color;
        module float IsOnlyChannelRed;

        // Shading of the sprite
        module override float4 Shading()
        {
            float4 color = base.Shading();
            if (IsOnlyChannelRed != 0)
            {
                color = float4(color.rrr, 1);
            }
            return color * Color;
        }
    };
}

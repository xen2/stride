namespace Stride.Rendering;

module VelocityStream
{
    import ShaderBase;

    // Screen space velocity
    stream float2 velocity;

    [Phase(Attributes)]
    extend ShaderBase.VSMain()
    {
        streams.velocity = float2(0,0);
    }
};

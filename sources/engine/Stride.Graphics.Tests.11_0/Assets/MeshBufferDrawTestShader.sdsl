namespace Stride.Graphics.Tests
{
    /// <summary>
    /// Fills the triangle with one color.
    /// </summary>
    internal shader MeshBufferDrawTestShader
    {
        import ShaderBase;

        module stream float3 Position : POSITION;

        module float4 Color;

        module override void VSMain()
        {
            streams.ShadingPosition = float4(streams.Position, 1.0f);
        }

        module override void PSMain()
        {
            streams.ColorTarget = Color;
        }
    };
}

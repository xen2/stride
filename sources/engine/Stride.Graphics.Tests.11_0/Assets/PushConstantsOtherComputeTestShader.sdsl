namespace Stride.Graphics.Tests
{
    /// <summary>
    /// Another pipeline, without push constants, bound between two dispatches of PushConstantsComputeTestShader.
    /// </summary>
    internal shader PushConstantsOtherComputeTestShader
    {
        import ComputeShaderBase;

        module RWStructuredBuffer<uint> Output;

        override void Compute()
        {
            Output[streams.DispatchThreadId.x] = 0xDEAD;
        }
    };
}

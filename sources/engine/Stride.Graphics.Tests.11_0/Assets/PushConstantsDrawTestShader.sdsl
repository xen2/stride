namespace Stride.Graphics.Tests
{
    /// <summary>
    /// Fills the render target with a color from the push constants, read in the pixel shader.
    /// </summary>
    internal shader PushConstantsDrawTestShader
    {
        import ImageEffectShader;

        [PushConstant] cbuffer PushData
        {
            float4 Color;
            float Intensity;
        };

        module override float4 Shading()
        {
            return float4(Color.rgb * Intensity, Color.a);
        }
    };
}

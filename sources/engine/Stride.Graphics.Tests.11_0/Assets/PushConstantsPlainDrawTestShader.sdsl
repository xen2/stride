namespace Stride.Graphics.Tests
{
    /// <summary>
    /// Another graphics pipeline, without push constants, drawn between two draws of PushConstantsDrawTestShader.
    /// </summary>
    internal shader PushConstantsPlainDrawTestShader
    {
        import ImageEffectShader;

        module override float4 Shading()
        {
            return float4(0, 0, 1, 1);
        }
    };
}

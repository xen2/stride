namespace Stride.MaterialTestBed
{
    /// <summary>
    /// A composed node with a point of its own: each node of an effect has its own chain.
    /// </summary>
    shader TestBedNode
    {
        [Phases(Base, Detail)]
        pipeline void ModifyColor(inout float3 color)
        {
        }

        float3 Evaluate(float3 color)
        {
            ModifyColor(color);
            return color;
        }
    };
}

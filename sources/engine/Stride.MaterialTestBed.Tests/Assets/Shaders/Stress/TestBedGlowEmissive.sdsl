namespace Stride.MaterialTestBed
{
    /// <summary>
    /// Changes only the optional part of the contract.
    /// </summary>
    [Pure]
    module TestBedGlowEmissive
    {
        import TestBedSurface;
        import TestBedShadingModel;

        extend TestBedShadingModel.ModelEmissive(Surface s)
        {
            return s.emissive * 2.0;
        }
    };
}

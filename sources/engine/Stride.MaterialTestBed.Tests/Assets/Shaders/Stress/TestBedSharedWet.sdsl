namespace Stride.MaterialTestBed
{
    /// <summary>Changes a plain static of a module.</summary>
    module TestBedSharedWet
    {
        import TestBedConflictPoints;

        [Phase(Scene)]
        extend TestBedConflictPoints.ModifyShared()
        {
            SharedValue = lerp(SharedValue, 0.1, 0.5);
        }
    };
}

namespace Stride.MaterialTestBed
{
    /// <summary>
    /// A wrapper that never calls next.
    /// </summary>
    module TestBedFixedPost
    {
        import SpriteBase;

        extend SpriteBase.Shading in Post
        {
            return float4(0.125, 0.125, 0.125, 1.0);
        }
    };
}

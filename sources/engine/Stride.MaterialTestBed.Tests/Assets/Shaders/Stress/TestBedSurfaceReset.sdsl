namespace Stride.MaterialTestBed
{
    /// <summary>Writes the whole surface, so a change made before it is lost.</summary>
    module TestBedSurfaceReset
    {
        import TestBedSurface;
        import TestBedSurfaceModifiers;

        [Phase(Scene)]
        extend TestBedSurfaceModifiers.ModifySurface(inout Surface s, SurfaceInput input)
        {
            Surface fresh = (Surface)0;
            fresh.roughness = 0.2;
            s = fresh;
        }
    };
}

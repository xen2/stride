namespace Stride.MaterialTestBed
{
    /// <summary>
    /// The same kind of data in three more places, each with a point that two contributors change.
    /// </summary>
    module TestBedConflictPoints
    {
        import TestBedCurrentSurface;

        static float SharedValue;
        stream float StreamValue;

        [Phases(Scene)]
        pipeline void ModifyCurrent() { }

        [Phases(Scene)]
        pipeline void ModifyShared() { }

        [Phases(Scene)]
        pipeline void ModifyStream() { }
    };
}

namespace Stride.MaterialTestBed
{
    /// <summary>Calls the point of the test-bed from a sprite.</summary>
    module TestBedFilterProbe
    {
        import SpriteBase;
        import TestBedColorFilter;

        extend SpriteBase.Shading in Surface
        {
            return float4(FilterColor(float3(0.25, 0.25, 0.25)), 1.0);
        }
    };
}

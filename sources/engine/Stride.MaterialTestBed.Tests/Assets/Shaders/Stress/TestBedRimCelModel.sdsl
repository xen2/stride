namespace Stride.MaterialTestBed
{
    /// <summary>
    /// Another model that says it takes the place of the cel model in this chain, wherever the mix puts it.
    /// </summary>
    [Pure]
    module TestBedRimCelModel
    {
        import TestBedSurface;
        import TestBedCelModel;

        [Replaces(TestBedCelModel)]
        extend TestBedShadingModel.ModelDirectLight(Surface s, LightSample light, float3 viewWS)
        {
            return float3(0.25, 0.25, 0.25);
        }
    };
}

namespace Stride.MaterialTestBed
{
    /// <summary>A step of a node.</summary>
    shader TestBedNodeDouble : TestBedNode
    {
        extend TestBedNode.ModifyColor in Base
        {
            color *= 2.0;
        }
    };
}

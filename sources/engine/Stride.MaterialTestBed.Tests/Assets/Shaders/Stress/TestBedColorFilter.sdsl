namespace Stride.MaterialTestBed
{
    /// <summary>
    /// A point that the test-bed declares: wrappers around a color.
    /// </summary>
    module TestBedColorFilter
    {
        [Phases(Outer, Inner)]
        around float3 FilterColor(float3 color)
        {
            return color;
        }
    };
}

namespace Stride.MaterialTestBed
{
    /// <summary>Only reads the roughness, so what it gives depends on who wrote it before.</summary>
    module TestBedSurfaceReader
    {
        import TestBedSurface;
        import TestBedSurfaceModifiers;

        extend TestBedSurfaceModifiers.ModifySurface in Scene
        {
            s.emissive = float3(s.roughness, s.roughness, s.roughness);
        }
    };
}

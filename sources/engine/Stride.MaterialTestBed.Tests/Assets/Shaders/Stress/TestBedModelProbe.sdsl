namespace Stride.MaterialTestBed
{
    /// <summary>
    /// Calls the shading model of the effect with fixed values, on a sprite.
    /// </summary>
    module TestBedModelProbe
    {
        import SpriteBase;
        import TestBedModelInputs;

        extend SpriteBase.Shading in Surface
        {
            return TestBedModelInputs.Evaluate();
        }
    };
}

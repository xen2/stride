namespace Stride.MaterialTestBed
{
    /// <summary>
    /// A cel model: light in hard bands. It writes the two required parts, and gets the emissive of the default.
    /// </summary>
    [Pure]
    module TestBedCelModel
    {
        import TestBedSurface;
        import TestBedStandardModel;
        import TestBedShadingModel;

        static const float CelBands = 3.0;

        float CelBand(float value)
        {
            return ceil(saturate(value) * CelBands) / CelBands;
        }

        extend TestBedShadingModel.ModelDirectLight(Surface s, LightSample light, float3 viewWS)
        {
            float nDotL = saturate(dot(s.normalWS, light.directionWS));
            float3 radiance = light.color * light.attenuation * light.shadow;
            return DiffuseColor(s) * CelBand(nDotL) * radiance;
        }

        extend TestBedShadingModel.ModelEnvironmentLight(Surface s, EnvironmentSample environment)
        {
            return DiffuseColor(s) * CelBand(environment.irradiance.g);
        }
    };
}

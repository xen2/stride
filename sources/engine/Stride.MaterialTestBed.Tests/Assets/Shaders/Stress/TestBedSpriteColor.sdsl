namespace Stride.MaterialTestBed
{
    /// <summary>
    /// The inner part of a sprite: a fixed color, in the phase that provides the surface.
    /// </summary>
    module TestBedSpriteColor
    {
        import SpriteBase;

        [Phase(Surface)]
        extend SpriteBase.Shading()
        {
            return float4(0.25, 0.5, 0.75, 1.0);
        }
    };
}

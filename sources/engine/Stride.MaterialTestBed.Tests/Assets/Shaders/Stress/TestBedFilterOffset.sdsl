namespace Stride.MaterialTestBed
{
    /// <summary>Adds to the result it gets from inward.</summary>
    module TestBedFilterOffset
    {
        import TestBedColorFilter;

        [Phase(Inner)]
        extend TestBedColorFilter.FilterColor(float3 color)
        {
            return next(color) + float3(0.125, 0.125, 0.125);
        }
    };
}

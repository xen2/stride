namespace Stride.MaterialTestBed
{
    /// <summary>Doubles the result it gets from inward.</summary>
    module TestBedFilterDouble
    {
        import TestBedColorFilter;

        [Phase(Inner)]
        extend TestBedColorFilter.FilterColor(float3 color)
        {
            return next(color) * 2.0;
        }
    };
}

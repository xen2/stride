namespace Stride.MaterialTestBed
{
    /// <summary>Settles the pair in a node, where a block of the effect doesn't reach.</summary>
    shader TestBedNodeDoubleLast : TestBedNode
    {
        [Phase(Base)]
        [MixinOrder(After = TestBedNodeOffset)]
        extend TestBedNode.ModifyColor(inout float3 color)
        {
            color *= 2.0;
        }
    };
}

namespace Stride.MaterialTestBed
{
    /// <summary>
    /// A sample with an automatic level of detail in a compute shader, which has no derivatives.
    /// </summary>
    shader TestBedAutomaticSampleCompute
    {
        import ComputeShaderBase;
        import Texturing;

        RWStructuredBuffer<float4> ModelResult;

        extend ComputeShaderBase.Compute()
        {
            ModelResult[0] = Texture0.Sample(Sampler, float2(0.5, 0.5));
        }
    };
}

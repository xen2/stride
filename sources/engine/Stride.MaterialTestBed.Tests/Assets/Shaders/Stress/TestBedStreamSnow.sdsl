namespace Stride.MaterialTestBed
{
    /// <summary>Changes a stream: the control of the conflict cases.</summary>
    module TestBedStreamSnow
    {
        import TestBedConflictPoints;

        [Phase(Scene)]
        extend TestBedConflictPoints.ModifyStream()
        {
            streams.StreamValue = lerp(streams.StreamValue, 0.9, 0.5);
        }
    };
}

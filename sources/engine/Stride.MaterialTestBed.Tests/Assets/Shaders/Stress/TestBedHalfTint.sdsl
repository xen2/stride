namespace Stride.MaterialTestBed
{
    /// <summary>
    /// A wrapper that changes the result after next.
    /// </summary>
    module TestBedHalfTint
    {
        import SpriteBase;

        extend SpriteBase.Shading in Post
        {
            return next() * float4(0.5, 0.5, 0.5, 1.0);
        }
    };
}

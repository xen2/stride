namespace Stride.MaterialTestBed
{
    /// <summary>
    /// A sample with an explicit level of detail: the one a pure module can have.
    /// </summary>
    [Pure]
    module TestBedPureSample
    {
        float4 ReadExplicit(Texture2D source, SamplerState samplerState, float2 uv)
        {
            return source.SampleLevel(samplerState, uv, 0.0);
        }
    };
}

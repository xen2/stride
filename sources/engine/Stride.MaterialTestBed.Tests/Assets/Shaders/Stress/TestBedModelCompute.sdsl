namespace Stride.MaterialTestBed
{
    /// <summary>
    /// The same evaluation as TestBedModelProbe, in a compute shader.
    /// </summary>
    shader TestBedModelCompute
    {
        import ComputeShaderBase;
        import TestBedModelInputs;

        RWStructuredBuffer<float4> ModelResult;

        extend ComputeShaderBase.Compute()
        {
            ModelResult[0] = Evaluate();
        }
    };
}

namespace Stride.MaterialTestBed
{
    /// <summary>
    /// The shading model of an effect, one point per part of the contract, with the Standard model as the default.
    /// </summary>
    [Pure]
    module TestBedShadingModel
    {
        import TestBedSurface;
        import TestBedStandardModel;

        [Replace]
        float3 ModelDirectLight(Surface s, LightSample light, float3 viewWS)
        {
            return DirectLight(s, light, viewWS);
        }

        [Replace]
        float3 ModelEnvironmentLight(Surface s, EnvironmentSample environment)
        {
            return EnvironmentLight(s, environment);
        }

        // An optional part: a model that doesn't write it gets this one
        [Replace]
        float3 ModelEmissive(Surface s)
        {
            return s.emissive;
        }
    };
}

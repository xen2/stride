namespace Stride.MaterialTestBed
{
    /// <summary>
    /// The snow modifier when its author knows the wetness modifier, and says so.
    /// </summary>
    module TestBedSnowAfterWetness
    {
        import TestBedSurface;
        import TestBedSurfaceModifiers;

        extend TestBedSurfaceModifiers.ModifySurface in Scene after TestBedWetness
        {
            s.roughness = lerp(s.roughness, 0.9, saturate(input.positionWS.y * 2.0));
        }
    };
}

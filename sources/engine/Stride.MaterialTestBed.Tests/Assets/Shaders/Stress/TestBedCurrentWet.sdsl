namespace Stride.MaterialTestBed
{
    /// <summary>Changes the surface of the pixel through the static of its module.</summary>
    module TestBedCurrentWet
    {
        import TestBedConflictPoints;

        [Phase(Scene)]
        extend TestBedConflictPoints.ModifyCurrent()
        {
            Current.roughness = lerp(Current.roughness, 0.1, 0.5);
        }
    };
}

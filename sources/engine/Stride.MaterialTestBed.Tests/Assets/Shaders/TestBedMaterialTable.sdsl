namespace Stride.MaterialTestBed
{
    /// <summary>
    /// The material table, and the index of the material of the current draw.
    /// </summary>
    module TestBedMaterialTable
    {
        import TestBedRecords;

        rgroup PerMaterial
        {
            StructuredBuffer<MaterialRecord> MaterialRecords;
            StructuredBuffer<LayerRecord> LayerRecords;
            StructuredBuffer<SlotRecord> SlotRecords;
        }

        [PushConstant] cbuffer PerDrawMaterial
        {
            uint MaterialIndex;
        };
    };
}

namespace Stride.MaterialTestBed
{
    /// <summary>
    /// A small version of the UV change of the SpaceEscape sample: per draw, moves the texture coordinates in the vertex shader.
    /// </summary>
    shader TestBedUvTransform
    {
        import ShaderBase;
        import Texturing;

        cbuffer PerDraw
        {
            module float4 TextureRegion = float4(0, 0, 1, 1);
        }

        extend ShaderBase.VSMain in Input
        {
            streams.TexCoord = TextureRegion.xy + TextureRegion.zw * streams.TexCoord;
        }
    };
}

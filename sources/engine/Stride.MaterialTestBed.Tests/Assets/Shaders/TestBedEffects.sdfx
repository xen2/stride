using Stride.MaterialTestBed;

namespace Stride.MaterialTestBed
{
    params TestBedEffectKeys
    {
        bool EnableUvTransform = false;
        bool EnableWetness = false;
        bool EnableSnow = false;
        bool EnableCel = false;
        bool EnableDebugView = false;
    }
}

namespace Stride.Rendering
{
    extend effect StrideForwardShadingEffect
    {
        using params TestBedEffectKeys;

        if (TestBedEffectKeys.EnableUvTransform)
            mixin TestBedUvTransform;

        if (TestBedEffectKeys.EnableWetness)
            mixin TestBedWetness;

        if (TestBedEffectKeys.EnableSnow)
            mixin TestBedSnow;

        if (TestBedEffectKeys.EnableCel)
            mixin TestBedCelModel;

        if (TestBedEffectKeys.EnableDebugView)
            mixin TestBedShadingDebugView;
    }
}

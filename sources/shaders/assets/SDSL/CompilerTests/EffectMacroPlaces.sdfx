namespace Stride.Shaders.Tests
{
    effect EffectMacroPart
    {
        mixin macro PART_MACRO = 1;
        mixin PartShader;
    };

    // Mixed: the macro is on the effect
    effect EffectMacroMixedPart
    {
        mixin macro TOP_MACRO = 2;
        mixin EffectMacroPart;
    };

    // Composed: the macro is in a composition
    effect EffectMacroComposedPart
    {
        mixin BaseShader;
        mixin compose Layer = EffectMacroPart;
    };
}

namespace Stride.Shaders.Tests
{
    effect EffectLinkagePart
    {
        unbind Owner.Run.Late;
        mixin PartShader;
    };

    // Mixed: the rule is on the effect
    effect EffectLinkageMixedPart
    {
        order Owner.Run.Early: First, Second;
        mixin EffectLinkagePart;
    };

    // Composed: the rule is in a composition
    effect EffectLinkageComposedPart
    {
        mixin BaseShader;
        mixin compose Layer = EffectLinkagePart;
    };
}

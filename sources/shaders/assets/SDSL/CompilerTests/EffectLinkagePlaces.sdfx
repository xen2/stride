namespace Stride.Shaders.Tests
{
    effect EffectLinkagePart
    {
        extend shader Owner { [Unbind(Phases = { Late })] Run; }
        mixin PartShader;
    };

    // Mixed: the block is on the effect
    effect EffectLinkageMixedPart
    {
        extend shader Owner { [MixinOrder(First, Second)] Run; }
        mixin EffectLinkagePart;
    };

    // Composed: the block is in a composition
    effect EffectLinkageComposedPart
    {
        mixin BaseShader;
        mixin compose Layer = EffectLinkagePart;
    };
}

// PSMain(ExpectedResult=#24242424, cbuffer.PerView=(Eye=7.0, Eye2=12.0))

namespace Stride.Shaders.Tests;

// This module is used twice by CompositionInheritanceStageIndirectAndDirect
// - through ShadingColor0 (a static reference from a composition)
// - imported by the root shader
// This test makes sure both use the one module in the root
module ExternalClass
{
    cbuffer PerView
    {
        float Eye;
    };
}

shader CompositionBase
{
	float4 Compute()
	{
		return float4(10.0, 10.0, 10.0, 10.0) / 255.0 + ExternalClass.Eye / 255.0;
	}
};

shader CompositionExternalBase
{
    stream float4 ColorTarget : SV_Target0;

	cbuffer PerView
    {
        module float Eye2;
    };

	compose CompositionBase ShadingColor0;
};

[Root]
shader CompositionInheritanceStageIndirectAndDirect : CompositionExternalBase
{
	import ExternalClass;

	module float4 Shading()
    {
        return ShadingColor0.Compute() + Eye2 / 255.0 + Eye / 255.0;
    }
 
	void PSMain()
	{
		streams.ColorTarget = Shading();
	}
};

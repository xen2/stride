// PSMain(ExpectedResult=#04040404)

namespace Stride.Shaders.Tests;

module StaticReferenceModuleOverriddenHelper
{
    float Value()
    {
        return 1.0;
    }
}

module StaticReferenceModuleOverriddenUser
{
    float Get()
    {
        return StaticReferenceModuleOverriddenHelper.Value();
    }
}

// Overrides a function of the helper, which it sees through the static reference of an imported module: the static call
// selects the override, as a call to an inherited method does. A plain override of a module function: root only.
[Root]
shader StaticReferenceModuleOverridden
{
    import StaticReferenceModuleOverriddenUser;

    stream float4 ColorTarget : SV_Target0;
    stream float4 Position : POSITION;
    stream float4 ShadingPosition : SV_Position;

    override float Value()
    {
        return 4.0;
    }

    void VSMain()
    {
        streams.ShadingPosition = streams.Position;
    }

    void PSMain()
    {
        float value = Get();
        streams.ColorTarget = float4(value, value, value, value) / 255.0;
    }
}

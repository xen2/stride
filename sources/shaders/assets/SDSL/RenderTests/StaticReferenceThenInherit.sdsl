// PSMain(ExpectedResult=#0C0C0C0C)

namespace Stride.Shaders.Tests;

module StaticReferenceThenInheritHelper
{
    float Twice(float value)
    {
        return value * 2.0;
    }
}

// Uses the helper through a static reference
module StaticReferenceThenInheritUser
{
    float Six()
    {
        return StaticReferenceThenInheritHelper.Twice(3.0);
    }
}

// Imports the helper after the user: the helper is one module, which the static reference uses too (no second copy)
shader StaticReferenceThenInherit
{
    import StaticReferenceThenInheritUser;
    import StaticReferenceThenInheritHelper;

    stream float4 ColorTarget : SV_Target0;
    stream float4 Position : POSITION;
    stream float4 ShadingPosition : SV_Position;

    void VSMain()
    {
        streams.ShadingPosition = streams.Position;
    }

    void PSMain()
    {
        float value = Six() + Twice(3.0);
        streams.ColorTarget = float4(value, value, value, value) / 255.0;
    }
}

namespace Stride.Rendering.Voxels
{
    /// <summary>
    /// Voxelization, projects to axis of largest area and writes fragments to buffer
    /// </summary>
    shader VoxelizeToFragments : ShadingBase, MaterialPixelStream, MaterialPixelShadingStream
    {
        import Math;
        import Transformation;
        import ShaderBase;
        import NormalUpdate;
        import Texturing;
        import NormalStream;
        import PositionStream4;
        import VoxelPositionStream;

        compose VoxelStorageShader Storage;

        // Input and shading only run for the fragments that are stored, and this is the only one that can tell
        [Drops(Phases = { Input, Shade })]
        override module void PSMain()
        {
            Storage.PrepareFragments();
            streams.IsFrontFace = true;
            if (Storage.MightStoreFragments())
            {
                GenerateNormal_PS();
                streams.ColorTarget = this.Shading();
                Storage.StoreFragments();
                streams.ColorTarget = float4(0,0,0,0);
            }
        }
        override module void VSMain()
        {
            base.VSMain();
            Storage.PrepareVertex();
        }
        #ifdef RequireGeometryShader
            [maxvertexcount(GeometryShaderMaxVertexCount)]
            void GSMain(triangle Input input[3], inout TriangleStream<Output> triangleStream)
            {
                Storage.GenerateTriangles(input, triangleStream);
            }
        #endif
    };
}

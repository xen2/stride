namespace Stride.Rendering;

/// <summary>
/// Mixed after an attribute: it writes at its own place in the fragments of a voxel.
/// </summary>
shader VoxelAttributeBufferOffset<int bufferOffset> : VoxelAttribute
{
    override void IndirectWrite(RWBuffer<uint> buffer, uint address)
    {
        base.IndirectWrite(buffer, address + bufferOffset);
    }
};
